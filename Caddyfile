# Self-signed TLS (no domain, no public CA) — Caddy issues and manages
# its own internal-CA certificate automatically. Browsers will show a
# "certificate not trusted" warning once per device; click through it
# (there's no way around that without a real hostname + Let's Encrypt).
:443 {
    tls internal
    reverse_proxy app:8080
}

# Plain HTTP redirects to HTTPS rather than serving unencrypted — if TLS
# was worth adding, it should actually be enforced.
:80 {
    redir https://{host}{uri} permanent
}
